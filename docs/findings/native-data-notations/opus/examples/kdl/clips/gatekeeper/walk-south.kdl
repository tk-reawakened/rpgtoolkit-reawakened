- kind=clip id="gatekeeper/walk-south" secondsPerFrame=0.15 {
  size 32 64
  frames {
    - id=step-left {
      tile tileset=people tile=12
      transparent 255 0 255
    }
    - id=stand {
      tile tileset=people tile=13
      transparent 255 0 255
    }
    - id=step-right sound="media/audio/step.wav" {
      tile tileset=people tile=14
      transparent 255 0 255
    }
  }
}
