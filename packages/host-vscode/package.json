    "./testing": { "types": "./dist/testing.d.ts", "default": "./dist/testing.js" }
  },
  "scripts": { "build": "node build.mjs" },
  "dependencies": {
    "@tk-reawakened/editor-model": "workspace:*",
    "@tk-reawakened/editor-ui": "workspace:*",
    "@tk-reawakened/platform-services": "workspace:*"
