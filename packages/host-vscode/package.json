{
  "name": "@tk-reawakened/host-vscode",
  "displayName": "RPG Toolkit Game Settings",
  "description": "VS Code host services and the game-settings custom editor provider.",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
