          }
        },
        "players": [{"id":"hero","x":48,"y":63,"layer":0,"speed":0.05,"facing":"S","controlled":true}]
      },
      "script": [
        {"t":2,"op":"send","board":"inn","x":3,"y":3,"layer":0,"caller":{"id":"story","kind":"blocking"}}
      ],
      "ticks": 6,
