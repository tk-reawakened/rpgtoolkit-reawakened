        {"t":3,"a":[["hero",80,95,0,"waiting","S"],["innkeeper",112,63,0,"waiting","S"]],"ev":[{"e":"send-swap","board":"inn"},{"e":"threads-stopped","ids":["town.clock","town.crowd","item:guard"]},{"e":"board-install","board":"inn"},{"e":"hydrate","id":"innkeeper","drawId":1,"index":0,"slot":0,"visible":true},{"e":"place-player","x":80,"y":95,"layer":0},{"e":"camera-align","on":"player","smoothing":0},{"e":"trigger-deactivate","x":80,"y":95,"layer":0},{"e":"music","file":"inn.mid"},{"e":"threads-started","ids":["inn.fire","inn.bard","item:innkeeper"]},{"e":"enter-program","program":"inn-enter.prg","as":"board"},{"e":"cache-flushed"},{"e":"caller-resume","thread":"story"}]},
