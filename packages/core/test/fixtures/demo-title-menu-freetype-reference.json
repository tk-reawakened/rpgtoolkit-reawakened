 "generator": [
  "import hashlib, json, sys, freetype",
  "from importlib.metadata import version",
  "from fontTools.ttLib import TTFont",
  "FONT = sys.argv[1]",
  "SIZE = 18",
  "RUNS = [(\"Test Game\", 36, 36), (\"New Game\", 288, 171), (\"Load Game\", 288, 198), (\"Quit\", 288, 225)]",
  "REGIONS = [(\"title\", 20, 28, 128, 36), (\"menu\", 280, 164, 120, 88)]",
  "tt = TTFont(FONT)",
  "upem = tt[\"head\"].unitsPerEm",
  "ascent = int(tt[\"hhea\"].ascent * SIZE / upem + 0.5)",
  "cmap, order, hmtx = tt.getBestCmap(), tt.getGlyphOrder(), tt[\"hmtx\"]",
  "face = freetype.Face(FONT)",
  "face.set_pixel_sizes(0, SIZE)",
  "flags = freetype.FT_LOAD_NO_HINTING | freetype.FT_LOAD_NO_BITMAP | freetype.FT_LOAD_RENDER",
  "W, H = 640, 480",
  "cov = [[0.0] * W for _ in range(H)]",
  "for text, x0, y0 in RUNS:",
  "    pen = x0",
  "    for ch in text:",
  "        name = cmap[ord(ch)]",
  "        face.load_glyph(order.index(name), flags)",
  "        g = face.glyph",
  "        bm = g.bitmap",
  "        raw = [[bm.buffer[r * bm.pitch + c] / 255.0 for c in range(bm.width)] for r in range(bm.rows)]",
  "        for r in range(bm.rows):",
  "            for c in range(bm.width + 1):",
  "                v = min(1.0, (raw[r][c] if c < bm.width else 0.0) + (raw[r][c - 1] if c else 0.0))",
  "                if v > 0:",
  "                    x, y = pen + g.bitmap_left + c, y0 + ascent - g.bitmap_top + r",
  "                    cov[y][x] += v * (1 - cov[y][x])",
  "        pen += int(hmtx[name][0] * SIZE / upem + 0.5) + 1",
  "def encode(row):",
  "    tokens, zeros, ink = [], 0, \"\"",
  "    for v in row:",
  "        if v == 0:",
  "            if ink: tokens.append(ink); ink = \"\"",
  "            zeros += 1",
  "        else:",
  "            if zeros: tokens.append(\"-%d\" % zeros); zeros = 0",
  "            ink += \"%02x\" % v",
  "    if ink: tokens.append(ink)",
  "    if zeros: tokens.append(\"-%d\" % zeros)",
  "    return \" \".join(tokens)",
  "regions = []",
  "for name, rx, ry, rw, rh in REGIONS:",
  "    rows = [encode([int(cov[y][x] * 255 + 0.5) for x in range(rx, rx + rw)]) for y in range(ry, ry + rh)]",
  "    regions.append({\"name\": name, \"x\": rx, \"y\": ry, \"width\": rw, \"height\": rh, \"rows\": rows})",
  "inked = {(x, y) for y in range(H) for x in range(W) if cov[y][x] > 0}",
  "assert all(any(r[\"x\"] <= x < r[\"x\"] + r[\"width\"] and r[\"y\"] <= y < r[\"y\"] + r[\"height\"] for r in regions) for x, y in inked)",
  "print(json.dumps({\"fontSha256\": hashlib.sha256(open(FONT, \"rb\").read()).hexdigest(), \"freetype\": \".\".join(map(str, freetype.version())), \"freetypePy\": version(\"freetype-py\"), \"fontTools\": version(\"fonttools\"), \"regions\": regions}))"
