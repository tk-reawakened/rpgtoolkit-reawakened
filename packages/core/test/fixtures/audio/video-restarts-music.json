        {"t":0,"op":"effect","kind":"music.play","asset":"media/song.mid","loop":true,"restart":false,"source":"board"},
        {"t":2,"op":"mediaPlay","file":"loop.wav","track":"ambience","flags":1},
        {"t":6,"op":"playavi","thread":1,"file":"Intro.avi"},
        {"t":7,"op":"video.ended","at":"pre","reqId":1}
      ],
      "ticks": 12,
      "expect": [
        {"t":0,"cfg":[["music",1],["sfx",1],["ambience",4],["voice",2],["ui",4]],"tr":[["music","playing",1,"media/song.mid",0,40,[[0,"playing",2,0,100,0,0,null,1,null]]]],"cues":[{"cueId":1,"tick":0,"kind":"soundfont.set","track":null,"voice":null,"asset":null,"loop":null,"flags":null,"positionTicks":null,"volume":null,"targetVolume":null,"durationTicks":null},{"cueId":2,"tick":0,"kind":"media.play","track":"music","voice":0,"asset":"media/song.mid","loop":true,"flags":1,"positionTicks":0,"volume":100,"targetVolume":null,"durationTicks":null}]},
