{
  "scene": "legacy-parity-ledger",
  "schema": 1,
  "note": "Authored from docs/spec; expected facts are derived by tools/fixtures/audio, not by packages/core. No state or cue hashes: later entries assert those.",
  "tick": "60 Hz fixed; phases input, waits, threads, events, movement, edges, triggers, animation, audio, time (AD-26). Random encounters hand off from triggers. A row is the state at the end of the audio phase of its tick.",
  "units": "ticks (1/60 s); volumes are integer percentages; seconds in scripts are whole milliseconds",
  "row": "t tick; cfg [track, configured voices] (first tick and on change); tr [track, state, flags, file, positionTicks, lengthTicks, voices] for each track with a file or a voice; voice [index, state, cueId, priority, volume, startTick, positionTicks, endTick, loop, fade [from, to, start, duration] or null]; bus [track, volume, fade]; master; sf (script bank); cues (the 12-key AudioCue records emitted this tick); ev (facts: wait, wake, finished, steal, same-file, diag, legacy, video ...)",
  "spec": [
    "docs/spec/engine/audio-media.md#legacy-audio-command-mapping",
    "docs/spec/engine/audio-media.md#audio-lifecycle",
    "docs/spec/engine/audio-media.md#r-59-routing",
    "docs/spec/engine/audio-media.md#audio-time-model"
  ],
  "proposed": ["P-8","P-11","P-15"],
  "ledger": [
    {"id":"Q1","kind":"timeline","fact":"mp3pause takes a file and, in 3.1.0, waits while the music keeps playing; no command pauses music.","disposition":"Follow 3.1.0: mp3pause(file) is a sfx once|wait play.","where":{"scene":"legacy-parity-ledger","case":"mp3pause-waits-while-music-keeps-playing"}},
    {"id":"Q2","kind":"timeline","fact":"wav never waits; mp3 aliases it.","disposition":"Keep.","where":{"scene":"legacy-parity-ledger","case":"wav-and-mp3-never-wait-and-play-once"}},
    {"id":"Q3","kind":"timeline","fact":"One sfx slot replaces a different file and ignores the same playing name.","disposition":"Keep on the one-voice sfx track.","where":{"scene":"legacy-parity-ledger","case":"one-sfx-slot-replaces-or-ignores"}},
    {"id":"Q4","kind":"timeline","fact":"wavStop stops the script, default-menu and default-battle sfx slot, not music or animation-frame sounds.","disposition":"Keep the sfx mapping; frame sounds join sfx (6.3 A5); menu sounds move to ui.","where":{"scene":"legacy-parity-ledger","case":"wavstop-leaves-music-alone"}},
    {"id":"Q5","kind":"timeline","fact":"The same music name (case-insensitive) carries on while playing and restarts when stopped.","disposition":"Keep in the music applier; tkMD_RESTART is the new override.","where":{"scene":"legacy-parity-ledger","case":"midiplay-carries-on-and-stop-retains"}},
    {"id":"Q6","kind":"timeline","fact":"Missing music stops the old music first, then is silent with no error.","disposition":"Keep: a null or missing board request stops and clears music, no error.","where":{"scene":"legacy-parity-ledger","case":"board-entry-silence-and-replay"}},
    {"id":"Q7","kind":"timeline","fact":"Board entry compares with the music loaded now; empty means silence; the final version blocks replay after an empty or failed name.","disposition":"Follow 3.1.0: compare the current track, empty is silence, no replay block.","where":{"scene":"legacy-parity-ledger","case":"board-entry-silence-and-replay"}},
    {"id":"Q8","kind":"timeline","fact":"A battle stops the board music; a fight without music has no fallback.","disposition":"Keep: battle uses the music track, no fallback track.","where":{"scene":"battle-music-handoff","case":"battle-without-music-is-silent"}},
    {"id":"Q9","kind":"timeline","fact":"Pre-fight music restarts from the beginning; in-fight changes are lost; game over restores it.","disposition":"Keep as the battle hand-off: the battle posts a restart of the saved pre-fight file.","where":{"scene":"battle-music-handoff","case":"battle-music-then-return"}},
    {"id":"Q10","kind":"timeline","fact":"mediaStop retains the name; a board, battle or video later restarts it.","disposition":"Keep: stop rewinds but retains file.","where":{"scene":"legacy-parity-ledger","case":"midiplay-carries-on-and-stop-retains"}},
    {"id":"Q11","kind":"departure","fact":"Legacy saves stored no audio; load plays the board music; reset does not stop music.","disposition":"Deliberate departure: the save carries playback and re-emits it, music restarts from zero; reset keeps legacy behaviour.","where":{"scene":"settings-versus-save","case":"save-and-load-restore-playback-not-settings"}},
    {"id":"Q12","kind":"timeline","fact":"Volume clamps 0..100, starts at 100 and is not remembered; in 3.1.0 zero is quiet-but-audible; the final version has no audible effect.","disposition":"Follow 3.1.0: integer script settings, initial 100, not a save or reset field.","where":{"scene":"legacy-parity-ledger","case":"setvolume-is-a-script-setting"}},
    {"id":"Q13","kind":"timeline","fact":"Volume is not saved and reset does not change it.","disposition":"Keep in the settings split.","where":{"scene":"settings-versus-save","case":"reset-leaves-audio-untouched"}},
    {"id":"Q14","kind":"unresolved","fact":"Frame sounds have a separate player apart from setVolume and wavStop; the frame-0 trigger depends on a missing owner breakdown.","disposition":"Amended by 6.3: frame sounds are one-shot sfx voices; frame-0 per-case timing is unruled until the owner supplies the fact.","where":{"scene":"animation-frame-sfx","case":"wavstop-stops-a-frame-sound"}},
    {"id":"Q15","kind":"runner","fact":"Focus loss pauses the game; the engine does not touch audio; the platform decides audibility.","disposition":"Keep: core stops advancing; the runner focus policy (pause by default) cannot change cue meaning. Not a core timeline fact.","where":null},
    {"id":"Q16","kind":"timeline","fact":"A video stops the music and freezes everything, cannot be skipped, and afterwards the music restarts from zero even if stopped.","disposition":"Keep: core hold, music stop and a restart effect with source video.","where":{"scene":"video-restarts-music","case":"stopped-music-restarts-anyway"}},
    {"id":"Q17","kind":"platform","fact":"3.1.0 played all listed formats and looped music; the final version played only MIDI.","disposition":"Follow 3.1.0 through import-time transcoding; trackers are a documented departure. Format policy is not a core timeline fact; the authored files carry the lengths.","where":null},
    {"id":"Q18","kind":"timeline","fact":"Files are under Media, subfolders allowed, no extension added, case-insensitive; packages did not unpack frame sounds or check videos.","disposition":"Keep the path rule and the ASCII fold (name folding is on every case); the package gaps are not reproduced.","where":{"scene":"same-file-rules","case":"music-same-file-carries-on"}},
    {"id":"Q19","kind":"timeline","fact":"The music virtual shows the battle music and is non-empty after mediaStop.","disposition":"Keep: it reads the music track's retained file.","where":{"scene":"battle-music-handoff","case":"music-virtual-follows-the-music-track-file"}},
    {"id":"M1","kind":"timeline","fact":"Music always loops in both versions and has no once argument.","disposition":"Keep tkMD_LOOP as the music default; tkMD_ONCE is a Reawakened addition.","where":{"scene":"legacy-parity-ledger","case":"midiplay-carries-on-and-stop-retains"}},
    {"id":"M2","kind":"timeline","fact":"Replaying an already-playing track carries on.","disposition":"Keep as the same-file rule unless tkMD_RESTART.","where":{"scene":"same-file-rules","case":"music-same-file-carries-on"}},
    {"id":"M3","kind":"timeline","fact":"Board and battle music use the same repeat setting.","disposition":"Keep: both are looping music.","where":{"scene":"battle-music-handoff","case":"battle-music-then-return"}},
    {"id":"M4","kind":"timeline","fact":"wav, mp3 and mp3pause never loop.","disposition":"Keep: every legacy sfx mapping is tkMD_ONCE.","where":{"scene":"legacy-parity-ledger","case":"wav-and-mp3-never-wait-and-play-once"}}
  ],
