        {"t":1,"tr":[["music","playing",1,"media/song.mid",1,30,[[0,"playing",2,0,100,0,1,null,1,null]]],["sfx","playing",0,"media/sting.wav",1,20,[[0,"playing",3,0,100,0,1,20,0,null]]]]},
