    {
      "name": "seek-clamps-wraps-and-rounds",
      "note": "mediaSeek converts milliseconds with half-up rounding (25 ms = 1.5 ticks = 2). A one-shot clamps to its length and finishes in the same tick; a loop wraps modulo its length; the end tick moves with the seek.",
      "setup": {
        "defaultSoundFont": null,
        "assets": {"media/song.mid":{"format":"audio.midi","lengthTicks":30},"media/sting.wav":{"format":"audio.wav","lengthTicks":20}},
        "videos": []
      },
      "script": [
        {"t":0,"op":"mediaPlay","file":"song.mid"},
        {"t":0,"op":"mediaPlay","file":"sting.wav","track":"sfx","flags":0},
