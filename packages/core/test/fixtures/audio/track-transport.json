    {
      "name": "diagnostics-leave-state-untouched",
      "note": "A missing file, an unknown track and an unknown voice each raise one located diagnostic and change nothing (no cue, no state). A file no decoder accepts does play, with one media.asset-format diagnostic; a seek on it (unknown length) and a negative seek time are then diagnosed and leave the voice as it was.",
      "setup": {
        "defaultSoundFont": null,
        "assets": {
          "media/song.mid": {"format":"audio.midi","lengthTicks":30},
          "media/sting.wav": {"format":"audio.wav","lengthTicks":20},
          "media/song.xm": {"format":"unsupported","lengthTicks":null}
        },
        "videos": []
      },
      "script": [
        {"t":1,"op":"mediaPlay","file":"nofile.wav","track":"sfx"},
        {"t":2,"op":"mediaPlay","file":"sting.wav","track":"nosuch"},
        {"t":3,"op":"mediaStop","track":"music","voice":3},
        {"t":4,"op":"mediaPlay","file":"song.xm"},
        {"t":5,"op":"mediaSeek","track":"music","ms":500},
        {"t":6,"op":"mediaSeek","track":"music","ms":-1}
      ],
      "ticks": 8,
      "expect": [
        {"t":0,"cfg":[["music",1],["sfx",1],["ambience",4],["voice",2],["ui",4]],"tr":[],"cues":[{"cueId":1,"tick":0,"kind":"soundfont.set","track":null,"voice":null,"asset":null,"loop":null,"flags":null,"positionTicks":null,"volume":null,"targetVolume":null,"durationTicks":null}]},
        {"t":1,"tr":[],"ev":[{"e":"diag","code":"media.asset-missing","op":"mediaPlay","file":"media/nofile.wav"}]},
        {"t":2,"tr":[],"ev":[{"e":"diag","code":"media.unknown-track","op":"mediaPlay","track":"nosuch"}]},
        {"t":3,"tr":[],"ev":[{"e":"diag","code":"media.unknown-voice","op":"mediaStop","track":"music","voice":3}]},
        {"t":4,"tr":[["music","playing",1,"media/song.xm",0,null,[[0,"playing",2,0,100,4,0,null,1,null]]]],"cues":[{"cueId":2,"tick":4,"kind":"media.play","track":"music","voice":0,"asset":"media/song.xm","loop":true,"flags":1,"positionTicks":0,"volume":100,"targetVolume":null,"durationTicks":null}],"ev":[{"e":"diag","code":"media.asset-format","op":"mediaPlay","file":"media/song.xm"}]},
        {"t":5,"tr":[["music","playing",1,"media/song.xm",1,null,[[0,"playing",2,0,100,4,1,null,1,null]]]],"ev":[{"e":"diag","code":"media.asset-length","op":"mediaSeek","track":"music","voice":0}]},
        {"t":6,"tr":[["music","playing",1,"media/song.xm",2,null,[[0,"playing",2,0,100,4,2,null,1,null]]]],"ev":[{"e":"diag","code":"media.invalid-time","op":"mediaSeek","ms":-1}]},
        {"t":7,"tr":[["music","playing",1,"media/song.xm",3,null,[[0,"playing",2,0,100,4,3,null,1,null]]]]}
