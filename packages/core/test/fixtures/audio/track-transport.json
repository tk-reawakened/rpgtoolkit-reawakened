        {"t":4,"op":"mediaSeek","track":"music","ms":1000},
        {"t":6,"op":"mediaSeek","track":"music","ms":750},
        {"t":9,"op":"mediaSeek","track":"music","ms":25},
        {"t":11,"op":"mediaPlay","file":"sting.wav","track":"sfx"},
        {"t":12,"op":"mediaSeek","track":"sfx","ms":1000}
      ],
      "ticks": 16,
