        "defaultSoundFont": null,
        "assets": {
          "media/town.mid": {"format":"audio.midi","lengthTicks":40},
          "media/cave.mid": {"format":"audio.midi","lengthTicks":30},
          "media/door.wav": {"format":"audio.wav","lengthTicks":8}
        },
        "videos": []
