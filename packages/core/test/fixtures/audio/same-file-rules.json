{
  "scene": "same-file-rules",
  "schema": 1,
  "note": "Authored from docs/spec; expected facts are derived by tools/fixtures/audio, not by packages/core. No state or cue hashes: later entries assert those.",
  "tick": "60 Hz fixed; phases input, waits, threads, events, movement, edges, triggers, animation, audio, time (AD-26). Random encounters hand off from triggers. A row is the state at the end of the audio phase of its tick.",
  "units": "ticks (1/60 s); volumes are integer percentages; seconds in scripts are whole milliseconds",
  "row": "t tick; cfg [track, configured voices] (first tick and on change); tr [track, state, flags, file, positionTicks, lengthTicks, voices] for each track with a file or a voice; voice [index, state, cueId, priority, volume, startTick, positionTicks, endTick, loop, fade [from, to, start, duration] or null]; bus [track, volume, fade]; master; sf (script bank); cues (the 12-key AudioCue records emitted this tick); ev (facts: wait, wake, finished, steal, same-file, diag, legacy, video ...)",
  "spec": [
    "docs/spec/engine/audio-media.md#audio-lifecycle",
    "docs/spec/engine/audio-media.md#media-command-family",
    "docs/spec/engine/audio-media.md#board-effect-mapping"
  ],
  "proposed": ["P-5","P-10","P-13"],
  "cases": [
    {
      "name": "music-same-file-carries-on",
      "note": "A same-file mediaPlay on a playing single-voice music track carries on with no cue, whatever the letter case of the name; the position is not disturbed.",
      "setup": {
        "defaultSoundFont": null,
        "assets": {
          "media/song.mid": {"format":"audio.midi","lengthTicks":40},
          "media/other.mid": {"format":"audio.midi","lengthTicks":40},
          "media/hit.wav": {"format":"audio.wav","lengthTicks":10},
          "media/step.wav": {"format":"audio.wav","lengthTicks":10},
          "media/blip.wav": {"format":"audio.wav","lengthTicks":6},
          "media/short.wav": {"format":"audio.wav","lengthTicks":5}
        },
        "videos": []
      },
      "script": [
        {"t":0,"op":"mediaPlay","file":"song.mid"},
        {"t":8,"op":"mediaPlay","file":"song.mid"},
        {"t":12,"op":"mediaPlay","file":"SONG.MID"}
      ],
      "ticks": 16,
      "expect": [
        {"t":0,"cfg":[["music",1],["sfx",1],["ambience",4],["voice",2],["ui",4]],"tr":[["music","playing",1,"media/song.mid",0,40,[[0,"playing",2,0,100,0,0,null,1,null]]]],"cues":[{"cueId":1,"tick":0,"kind":"soundfont.set","track":null,"voice":null,"asset":null,"loop":null,"flags":null,"positionTicks":null,"volume":null,"targetVolume":null,"durationTicks":null},{"cueId":2,"tick":0,"kind":"media.play","track":"music","voice":0,"asset":"media/song.mid","loop":true,"flags":1,"positionTicks":0,"volume":100,"targetVolume":null,"durationTicks":null}]},
        {"t":1,"tr":[["music","playing",1,"media/song.mid",1,40,[[0,"playing",2,0,100,0,1,null,1,null]]]]},
        {"t":2,"tr":[["music","playing",1,"media/song.mid",2,40,[[0,"playing",2,0,100,0,2,null,1,null]]]]},
        {"t":3,"tr":[["music","playing",1,"media/song.mid",3,40,[[0,"playing",2,0,100,0,3,null,1,null]]]]},
        {"t":4,"tr":[["music","playing",1,"media/song.mid",4,40,[[0,"playing",2,0,100,0,4,null,1,null]]]]},
        {"t":5,"tr":[["music","playing",1,"media/song.mid",5,40,[[0,"playing",2,0,100,0,5,null,1,null]]]]},
        {"t":6,"tr":[["music","playing",1,"media/song.mid",6,40,[[0,"playing",2,0,100,0,6,null,1,null]]]]},
        {"t":7,"tr":[["music","playing",1,"media/song.mid",7,40,[[0,"playing",2,0,100,0,7,null,1,null]]]]},
        {"t":8,"tr":[["music","playing",1,"media/song.mid",8,40,[[0,"playing",2,0,100,0,8,null,1,null]]]],"ev":[{"e":"same-file","track":"music","file":"media/song.mid","action":"carry-on"}]},
        {"t":9,"tr":[["music","playing",1,"media/song.mid",9,40,[[0,"playing",2,0,100,0,9,null,1,null]]]]},
        {"t":10,"tr":[["music","playing",1,"media/song.mid",10,40,[[0,"playing",2,0,100,0,10,null,1,null]]]]},
        {"t":11,"tr":[["music","playing",1,"media/song.mid",11,40,[[0,"playing",2,0,100,0,11,null,1,null]]]]},
        {"t":12,"tr":[["music","playing",1,"media/song.mid",12,40,[[0,"playing",2,0,100,0,12,null,1,null]]]],"ev":[{"e":"same-file","track":"music","file":"media/song.mid","action":"carry-on"}]},
        {"t":13,"tr":[["music","playing",1,"media/song.mid",13,40,[[0,"playing",2,0,100,0,13,null,1,null]]]]},
        {"t":14,"tr":[["music","playing",1,"media/song.mid",14,40,[[0,"playing",2,0,100,0,14,null,1,null]]]]},
        {"t":15,"tr":[["music","playing",1,"media/song.mid",15,40,[[0,"playing",2,0,100,0,15,null,1,null]]]]}
      ],
      "end": {"cueId":3,"soundFont":null,"master":100}
    },
