{
  "name": "tkr-editor-vscode-web-proof-probe",
  "displayName": "TK Reawakened editor web proof probe",
  "publisher": "tk-reawakened-test",
  "version": "0.0.0",
  "engines": {
    "vscode": "^1.91.0"
  },
  "browser": "extension.js",
  "activationEvents": [
    "onFileSystem:tkr-testfs",
    "onCommand:tkr.editorWebProof.copyMainFileBytes",
    "onCommand:tkr.editorWebProof.writeGameBytes",
    "onCommand:tkr.editorWebProof.enableAutosave",
    "onCommand:tkr.editorWebProof.disableAutosave",
    "onCommand:tkr.editorWebProof.invokePackageCommand"
  ],
  "contributes": {
    "commands": [
      {
        "command": "tkr.editorWebProof.copyMainFileBytes",
        "title": "Test: Copy Main File Bytes"
      },
      {
        "command": "tkr.editorWebProof.writeGameBytes",
        "title": "Test: Write Main File Bytes"
      },
      {
        "command": "tkr.editorWebProof.enableAutosave",
        "title": "Test: Turn Autosave On"
      },
      {
        "command": "tkr.editorWebProof.disableAutosave",
        "title": "Test: Turn Autosave Off"
      },
      {
        "command": "tkr.editorWebProof.invokePackageCommand",
        "title": "Test: Execute Package Game"
      }
    ]
  }
}
