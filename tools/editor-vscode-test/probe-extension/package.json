{
  "name": "tkr-editor-vscode-web-proof-probe",
  "displayName": "TK Reawakened editor web proof probe",
  "publisher": "tk-reawakened-test",
  "version": "0.0.0",
  "engines": {
    "vscode": "^1.91.0"
  },
  "browser": "extension.js",
  "activationEvents": [
    "onFileSystem:tkr-testfs",
    "onCommand:tkr.editorWebProof.runExampleGame",
    "onCommand:tkr.editorWebProof.runExampleProgram",
    "onCommand:tkr.editorWebProof.failSaves",
    "onCommand:tkr.editorWebProof.allowSaves",
    "onCommand:tkr.editorWebProof.pauseProgramRead",
    "onCommand:tkr.editorWebProof.resumeProgramRead",
    "onCommand:tkr.editorWebProof.copyMainFileBytes",
    "onCommand:tkr.editorWebProof.writeGameBytes",
    "onCommand:tkr.editorWebProof.enableAutosave",
    "onCommand:tkr.editorWebProof.disableAutosave"
  ],
  "contributes": {
    "commands": [
      {
        "command": "tkr.editorWebProof.runExampleGame",
        "title": "Test: Run Example Game"
      },
      {
        "command": "tkr.editorWebProof.runExampleProgram",
        "title": "Test: Run Example Program"
      },
      { "command": "tkr.editorWebProof.failSaves", "title": "Test: Fail Saves" },
      { "command": "tkr.editorWebProof.allowSaves", "title": "Test: Allow Saves" },
      { "command": "tkr.editorWebProof.pauseProgramRead", "title": "Test: Pause Program Read" },
      { "command": "tkr.editorWebProof.resumeProgramRead", "title": "Test: Resume Program Read" },
      {
        "command": "tkr.editorWebProof.copyMainFileBytes",
        "title": "Test: Copy Main File Bytes"
      },
      {
        "command": "tkr.editorWebProof.writeGameBytes",
        "title": "Test: Write Main File Bytes"
      },
      {
        "command": "tkr.editorWebProof.enableAutosave",
        "title": "Test: Turn Autosave On"
      },
      {
        "command": "tkr.editorWebProof.disableAutosave",
        "title": "Test: Turn Autosave Off"
      },
      {
        "command": "tkr.editorWebProof.pauseAutosaveOff",
        "title": "Test: Pause Autosave Off"
      },
      {
        "command": "tkr.editorWebProof.releaseAutosaveOff",
        "title": "Test: Release Autosave Off"
      }
    ]
  }
}
