{
  "name": "rpgtoolkit-reawakened",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && pnpm -r --if-present run typecheck:tests && tsc -p packages/runner-web/tsconfig.app.json",
    "test": "tsc -b && node --test \"packages/*/test/*.test.ts\"",
    "coverage": "tsc -b && mkdir -p coverage && node --experimental-test-coverage --test-coverage-lines=91 --test-coverage-branches=81 --test-coverage-include='packages/*/src/**' --test-coverage-exclude='**/catalogue-stubs.ts' --test-reporter=spec --test-reporter=lcov --test-reporter-destination=stdout --test-reporter-destination=coverage/lcov.info --test \"packages/*/test/*.test.ts\"",
    "test:strict": "tsc -b && node tools/no-skips/run.mjs",
    "lint": "node tools/check-core-deps.mjs && eslint .",
    "graph": "node tools/deps/graph.mjs",
    "graph:write": "node tools/deps/graph.mjs --write",
    "graph:test": "node --test tools/deps/test/graph.test.mjs",
    "licence": "node tools/licences/check.mjs",
    "licence:test": "node --test tools/licences/test/licences.test.mjs",
    "license": "pnpm run licence",
    "license:test": "pnpm run licence:test",
    "provenance": "node tools/provenance/scan.mjs",
    "provenance:test": "node --test tools/provenance/test/provenance.test.mjs",
    "fixtures:fetch": "node tools/fixtures/fetch.mjs",
    "fixtures:check": "node tools/fixtures/check.mjs",
    "fixtures:author": "node tools/fixtures/author/generate.mjs",
    "fixtures:author:check": "node tools/fixtures/author/generate.mjs --check",
    "fixtures:test": "node --test tools/fixtures/test/fixtures.test.mjs tools/fixtures/test/movement.test.mjs tools/fixtures/test/audio.test.mjs tools/fixtures/test/audio-protocol.test.mjs tools/fixtures/test/runner-protocol.test.mjs",
    "font:generate": "node tools/fonts/generate.mjs",
    "font:check": "node tools/fonts/generate.mjs --check",
    "catalogue:generate": "node tools/catalogue/generate.mjs",
    "catalogue:check": "node tools/catalogue/generate.mjs --check",
    "command-docs:check": "pnpm build && node tools/command-docs/check.mjs",
    "command-docs:test": "node --test tools/command-docs/test/*.test.mjs",
    "icons": "node tools/icons/build.mjs",
    "icons:test": "node --test tools/icons/test/icons.test.mjs",
    "no-skips:test": "node --test tools/no-skips/test/no-skips.test.mjs",
    "audio-protocol:check": "node tools/fixtures/audio-protocol/generate.mjs --check",
    "runner-protocol:check": "node tools/fixtures/runner-protocol/generate.mjs --check",
    "browser:build": "node tools/browser/build.mjs",
    "browser:serve": "node tools/browser/serve.mjs --port 4173",
    "browser:test": "node tools/browser/build.mjs && playwright test",
    "oracle:check": "python3 tools/fixtures/reference/render.py --check && node tools/fixtures/author/generate.mjs --check && pnpm run audio-protocol:check && pnpm run runner-protocol:check",
    "golden": "tsc -b && node packages/runner-headless/dist/cli.js golden",
    "golden:record": "tsc -b && node packages/runner-headless/dist/cli.js golden --record",
    "golden:bun": "pnpm build && bun packages/runner-headless/dist/cli.js golden && bun packages/runner-headless/dist/cli.js closing",
    "closing": "tsc -b && node packages/runner-headless/dist/cli.js closing",
    "closing:record": "tsc -b && node packages/runner-headless/dist/cli.js closing --record",
    "corpus": "tsc -b && node packages/runner-headless/dist/cli.js corpus",
    "dump": "tsc -b && node packages/runner-headless/dist/cli.js dump",
    "dump:check": "tsc -b && node packages/runner-headless/dist/cli.js dump --check golden/legacy-corpus.json fixtures/legacy && node packages/runner-headless/dist/cli.js dump --check golden/spec-examples.json docs/spec/examples",
    "dump:record": "tsc -b && node packages/runner-headless/dist/cli.js dump --record golden/legacy-corpus.json fixtures/legacy",
    "dump:check:examples": "tsc -b && node packages/runner-headless/dist/cli.js dump --check golden/spec-examples.json docs/spec/examples",
    "dump:record:examples": "tsc -b && node packages/runner-headless/dist/cli.js dump --record golden/spec-examples.json docs/spec/examples",
    "make-package": "node tools/make-package/run.mjs",
    "make-package:test": "node --test tools/make-package/test/make-package.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tk-reawakened/core": "workspace:*",
    "@typescript/native": "npm:typescript@7.0.2",
    "dependency-cruiser": "18.5.0",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.71.1"
  }
}
